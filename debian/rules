#!/usr/bin/make -f
#
# Dagda - The Store
#
# Copyright (C) 2026 Tom Cully <mail@tomcully.com>
# Licensed under the GNU GPLv3 - see <https://www.gnu.org/licenses/gpl-3.0.html>
#
# The CMake install rules say where everything goes; this splits it between the
# library, its development files and the tools. The library's package is named
# for its SONAME, the whole version, and debian/control names it.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk

LIBRARY := $(shell sed -n 's/^Package: \(libdagda[0-9].*\)/\1/p' debian/control)

ifneq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
TESTS = OFF
else
TESTS = ON
endif

%:
	dh $@ --buildsystem=cmake --builddirectory=debian/build

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DDAGDA_BUILD_TESTING=$(TESTS)

# The test binary rather than ctest. Every connection the tests make is on the
# loopback interface.
override_dh_auto_test:
ifeq ($(TESTS),ON)
	debian/build/dagda_tests
endif

# A host built against this library depends on at least the release it was built
# with (each release is its own package while the SONAME is the whole version).
override_dh_makeshlibs:
	dh_makeshlibs -V

# One path to each call: given several, dh_install takes the last as the
# destination. The glob is quoted for dh_install to expand under debian/tmp.
override_dh_install:
	dh_install -p$(LIBRARY) 'usr/lib/$(DEB_HOST_MULTIARCH)/libdagda.so.*'
	dh_install -plibdagda-dev usr/include/dagda
	dh_install -plibdagda-dev usr/lib/$(DEB_HOST_MULTIARCH)/libdagda.so
	dh_install -plibdagda-dev usr/lib/$(DEB_HOST_MULTIARCH)/cmake/dagda
	dh_install -pdagda-tools usr/bin
	dh_install -pdagda-tools usr/share/man/man1
